+// Compute dot product between dequantized q4_0 block and f32 column vector
+// Vectorized: processes 8 elements at a time using ET vector instructions
+// Block size: 32 int4 values packed in 16 bytes (QK4_0)
+static inline float compute_block_dot_product_q4_0(const block_q4_0* a_block, const float* b_col_start) {
+    const float scale = fp16_to_fp32(a_block->d);
+    const float bias = -8.0f * scale;
+
+    unsigned long temp_mask;
+    __asm__ volatile("mova.x.m %0" : "=r"(temp_mask));
+    __asm__ volatile("mov.m.x m0, x0, 0xFF");
+    __asm__ volatile("fbci.pi f10, 0" ::: "f10"); // accumulator
+
+    static const int32_t gather_pattern[8] = {0, 1, 2, 3, 4, 5, 6, 7};
+    __asm__ volatile("flw.ps f31, %[gather]\n" : : [gather] "m"(*(const int32_t(*)[8])gather_pattern) : "f31");
+
+    __asm__ volatile (
+        "fbcx.ps f20, %[scale] \n\t"
+        "fbcx.ps f21, %[bias] \n\t"
+        : : [scale] "r"(scale), [bias] "r"(bias) : "f20", "f21"
+    );
+
+    for (int chunk = 0; chunk < 2; chunk++) {
+        int byte_offset = chunk << 3;      // 0, 8
+        int elem_offset = chunk << 3;      // 0, 8
+        int high_elem_offset = elem_offset + 16; // 16, 24
+        
+        __asm__ volatile(
+            "fgb.ps f11, f31(%[a_ptr])\n"      
+            
+            // low nibbles
+            "fandi.pi f12, f11, 0xF\n"         
+            "fcvt.ps.pw f12, f12\n"            
+            "fmul.ps f12, f12, f20\n"
+            "fadd.ps f12, f12, f21\n"
+            "flw.ps f13, %[b_low]\n"           
+            "fmadd.ps f10, f12, f13, f10\n"    
+            
+            // high nibbles
+            "fsrli.pi f14, f11, 4\n"           
+            "fandi.pi f14, f14, 0xF\n"         
+            "fcvt.ps.pw f14, f14\n"            
+            "fmul.ps f14, f14, f20\n"
+            "fadd.ps f14, f14, f21\n"
+            "flw.ps f15, %[b_high]\n"          
+            "fmadd.ps f10, f14, f15, f10\n"    
+            
+            :
+            : [a_ptr] "r"(&a_block->qs[byte_offset]),
+              [b_low] "m"(*(const float(*)[8])&b_col_start[elem_offset]),
+              [b_high] "m"(*(const float(*)[8])&b_col_start[high_elem_offset])
+            : "f11", "f12", "f13", "f14", "f15"
+        );
+    }
+
+    // Horizontal sum
+    float final_sum;
+    __asm__ __volatile__ (
+        "fswizz.ps f1, f10, 0xB1 \n\t"
+        "fadd.ps   f2, f10, f1, rne \n\t"
+        "fswizz.ps f3, f2, 0x4E \n\t"
+        "fadd.ps   f4, f2, f3, rne \n\t"
+        "fmvz.x.ps t0, f4, 4 \n\t"
+        "fbcx.ps   f5, t0 \n\t"
+        "fadd.ps   %[vout], f4, f5, rne \n\t"
+        : [vout] "=f" (final_sum)
+        :: "t0", "f1", "f2", "f3", "f4", "f5"
+    );
+
+    __asm__ volatile("mova.m.x %0" :: "r"(temp_mask));
+    return final_sum;
+}
 
